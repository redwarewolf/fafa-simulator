[node name="LoadGameButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
text = "Cargar Partida"

[node name="LoadGameHint" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "Todavía no hay un club guardado"
horizontal_alignment = 1
