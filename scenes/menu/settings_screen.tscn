[node name="MasterLabel" type="Label" parent="Center/VBox/VolumeGrid"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "General"

[node name="MasterSlider" type="HSlider" parent="Center/VBox/VolumeGrid"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
size_flags_vertical = 4
step = 5.0

[node name="MasterValue" type="Label" parent="Center/VBox/VolumeGrid"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
