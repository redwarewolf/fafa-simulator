[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/menu/settings_screen.gd" id="1"]
[ext_resource type="Theme" path="res://assets/themes/main_theme.tres" id="2"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Configuración"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="LanguageLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "Idioma"
horizontal_alignment = 1

[node name="LocaleRow" type="HBoxContainer" parent="Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="SpanishButton" type="Button" parent="Center/VBox/LocaleRow"]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "Español"

[node name="EnglishButton" type="Button" parent="Center/VBox/LocaleRow"]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "English"

[node name="BackButton" type="Button" parent="."]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 96.0
offset_bottom = 48.0
text = "< Volver"

[connection signal="pressed" from="Center/VBox/LocaleRow/SpanishButton" to="." method="_on_spanish_pressed"]
[connection signal="pressed" from="Center/VBox/LocaleRow/EnglishButton" to="." method="_on_english_pressed"]
[connection signal="pressed" from="BackButton" to="." method="_on_back_pressed"]
